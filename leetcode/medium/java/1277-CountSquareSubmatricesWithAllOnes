class Solution {
    public int countSquares(int[][] matrix) {
        int cols = matrix[0].length;
        int rows = matrix.length;
        int res = 0;

        //get left side, top side, and left diagonal, so no need to start at 0
        //iterate at the end to get sum of 1s
        for (int i = 1; i < rows; i++) {
            for (int j = 1; j < cols; j++) {
                if (matrix[i][j] == 0)
                    continue;

                //if at edge (top or left) sum value
                //get min of all, if 1 sum 1, meaning 2 side square, if 0 add 1 for 1 side
                matrix[i][j]+= Math.min(
                    matrix[i - 1][j - 1],
                    Math.min(matrix[i - 1][j], matrix[i][j - 1]));
            }
        }
        
        for (int i = 0; i < rows; i++) {
            for (int j = 0; j < cols; j++) {
                res += matrix[i][j];
            }
        }
        return res;
    }
}
