class Solution {
    public int[] productExceptSelf(int[] nums) {
        final int[] array = new int[nums.length];
        //multiplying by 1 so its as if num i is not being used
        int right = 1;
        int left = 1;

        for(int i = 0; i < nums.length; i++) {
            array[i] = left;
            left *= nums[i];
        }

        for(int i = nums.length - 1; i >= 0; i--) {
            array[i] *= right;
            right *= nums[i];
        }

        return array;
    }
}
