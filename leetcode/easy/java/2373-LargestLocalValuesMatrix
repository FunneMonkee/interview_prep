class Solution {
    public int[][] largestLocal(int[][] grid) {
        int n = grid.length;
        int[][] res = new int[n - 2][n - 2];

        //no need for n - 2
        //since no matrix can be done there
        //also allows us to check i and j +3 without out of bounds
        for (int i = 0; i < n - 2; i++) {
            for (int j = 0; j < n - 2; j++) {
                int max = 0;
                //check each matrix possible from the inside
                for (int k = i; k < i + 3; k++) {
                    for (int l = j; l < j + 3; l++) {
                        max = Math.max(max, grid[k][l]);
                    }
                }

                res[i][j] = max;
            }
        }

        return res;
    }
}
